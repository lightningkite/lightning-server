{
    "resource": {
        "aws_sns_topic": {
            "emergency": {
                "name": "demo-example_emergencies"
            }
        },
        "aws_cloudwatch_metric_alarm": {
            "panic_invocations": {
                "alarm_name": "demo-example_panic_invocations",
                "period": 60,
                "statistic": "Sum",
                "alarm_actions": [
                    "${aws_sns_topic.emergency.arn}"
                ],
                "threshold": 450,
                "datapoints_to_alarm": 1,
                "insufficient_data_actions": [],
                "metric_name": "Invocations",
                "evaluation_periods": 1,
                "alarm_description": "",
                "comparison_operator": "GreaterThanOrEqualToThreshold",
                "namespace": "AWS/Lambda",
                "dimensions": {
                    "FunctionName": "${aws_lambda_function.main.function_name}"
                }
            },
            "emergency_compute": {
                "alarm_name": "demo-example_emergency_compute",
                "period": 60,
                "statistic": "Sum",
                "alarm_actions": [
                    "${aws_sns_topic.emergency.arn}"
                ],
                "threshold": 180000,
                "datapoints_to_alarm": 1,
                "insufficient_data_actions": [],
                "metric_name": "Duration",
                "evaluation_periods": 1,
                "alarm_description": "",
                "comparison_operator": "GreaterThanOrEqualToThreshold",
                "namespace": "AWS/Lambda",
                "dimensions": {
                    "FunctionName": "${aws_lambda_function.main.function_name}"
                }
            },
            "panic_compute": {
                "alarm_name": "demo-example_panic_compute",
                "period": 60,
                "statistic": "Sum",
                "alarm_actions": [
                    "${aws_sns_topic.emergency.arn}"
                ],
                "threshold": 300000,
                "datapoints_to_alarm": 1,
                "insufficient_data_actions": [],
                "metric_name": "Duration",
                "evaluation_periods": 1,
                "alarm_description": "",
                "comparison_operator": "GreaterThanOrEqualToThreshold",
                "namespace": "AWS/Lambda",
                "dimensions": {
                    "FunctionName": "${aws_lambda_function.main.function_name}"
                }
            },
            "emergency_invocations": {
                "alarm_name": "demo-example_emergency_invocations",
                "period": 60,
                "statistic": "Sum",
                "alarm_actions": [
                    "${aws_sns_topic.emergency.arn}"
                ],
                "threshold": 150,
                "datapoints_to_alarm": 1,
                "insufficient_data_actions": [],
                "metric_name": "Invocations",
                "evaluation_periods": 1,
                "alarm_description": "",
                "comparison_operator": "GreaterThanOrEqualToThreshold",
                "namespace": "AWS/Lambda",
                "dimensions": {
                    "FunctionName": "${aws_lambda_function.main.function_name}"
                }
            }
        },
        "aws_api_gateway_account": {
            "main": {
                "cloudwatch_role_arn": "${aws_iam_role.cloudwatch.arn}"
            }
        },
        "aws_iam_role": {
            "cloudwatch": {
                "name": "demoexample",
                "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Action\":\"sts:AssumeRole\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":[\"apigateway.amazonaws.com\",\"lambda.amazonaws.com\"]},\"Sid\":\"\"}]}"
            }
        },
        "aws_sns_topic_subscription": {
            "emergency_primary": {
                "protocol": "email",
                "endpoint": "josephivie@gmail.com",
                "topic_arn": "${aws_sns_topic.emergency.arn}"
            }
        },
        "aws_iam_role_policy": {
            "cloudwatch": {
                "role": "${aws_iam_role.cloudwatch.id}",
                "name": "demoexample_policy",
                "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Action\":[\"logs:CreateLogGroup\",\"logs:CreateLogStream\",\"logs:DescribeLogGroups\",\"logs:DescribeLogStreams\",\"logs:PutLogEvents\",\"logs:GetLogEvents\",\"logs:FilterLogEvents\"],\"Resource\":\"*\",\"Effect\":\"Allow\"}]}"
            }
        }
    }
}