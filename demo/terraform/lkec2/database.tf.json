{
    "resource": {
        "aws_docdb_subnet_group": {
            "database": {
                "name": "lightningserverec2sdemo-database",
                "subnet_ids": "${module.vpc.private_subnets}"
            }
        },
        "aws_docdb_cluster": {
            "database": {
                "backup_retention_period": 1,
                "engine": "docdb",
                "master_password": "${random_password.database.result}",
                "deletion_protection": false,
                "vpc_security_group_ids": [
                    "${aws_security_group.internal.id}"
                ],
                "storage_encrypted": true,
                "db_subnet_group_name": "${aws_docdb_subnet_group.database.name}",
                "cluster_identifier": "lightningserverec2sdemo-database",
                "engine_version": "5.0",
                "skip_final_snapshot": true,
                "master_username": "master"
            }
        },
        "random_password": {
            "database": {
                "special": true,
                "length": 32,
                "override_special": "-_"
            }
        },
        "aws_vpc_security_group_ingress_rule": {
            "database_docdb": {
                "referenced_security_group_id": "${aws_security_group.internal.id}",
                "security_group_id": "${aws_security_group.internal.id}",
                "to_port": 27017,
                "from_port": 27017,
                "ip_protocol": "tcp"
            }
        },
        "aws_docdb_cluster_instance": {
            "database_0": {
                "identifier": "lightningserverec2sdemo-database-0",
                "instance_class": "db.t4g.medium",
                "auto_minor_version_upgrade": true,
                "cluster_identifier": "${aws_docdb_cluster.database.id}"
            }
        }
    }
}