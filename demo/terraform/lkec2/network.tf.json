{
    "resource": {
        "aws_security_group": {
            "instance": {
                "vpc_id": "${module.vpc.vpc_id}",
                "name": "LightningServerEC2SDemo-instance",
                "description": "Lightning Server Demo application instances"
            },
            "alb": {
                "vpc_id": "${module.vpc.vpc_id}",
                "name": "LightningServerEC2SDemo-alb",
                "description": "Lightning Server Demo load balancer"
            }
        },
        "aws_vpc_security_group_ingress_rule": {
            "alb_https_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.alb.id}",
                "to_port": 443,
                "from_port": 443,
                "ip_protocol": "tcp"
            },
            "instance_from_alb": {
                "referenced_security_group_id": "${aws_security_group.alb.id}",
                "security_group_id": "${aws_security_group.instance.id}",
                "to_port": 8080,
                "from_port": 8080,
                "ip_protocol": "tcp"
            },
            "alb_http": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.alb.id}",
                "to_port": 80,
                "from_port": 80,
                "ip_protocol": "tcp"
            },
            "alb_http_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.alb.id}",
                "to_port": 80,
                "from_port": 80,
                "ip_protocol": "tcp"
            },
            "alb_https": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.alb.id}",
                "to_port": 443,
                "from_port": 443,
                "ip_protocol": "tcp"
            }
        },
        "aws_vpc_security_group_egress_rule": {
            "instance_outbound": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.instance.id}",
                "ip_protocol": -1
            },
            "instance_outbound_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.instance.id}",
                "ip_protocol": -1
            },
            "alb_to_instance": {
                "referenced_security_group_id": "${aws_security_group.instance.id}",
                "security_group_id": "${aws_security_group.alb.id}",
                "to_port": 8080,
                "from_port": 8080,
                "ip_protocol": "tcp"
            }
        }
    }
}