{
    "data": {
        "aws_subnets": {
            "main": {
                "filter": {
                    "values": [
                        "${data.aws_vpc.default.id}"
                    ],
                    "name": "vpc-id"
                }
            }
        },
        "aws_vpc": {
            "default": {
                "default": true
            }
        }
    },
    "resource": {
        "aws_security_group": {
            "ec2": {
                "vpc_id": "${data.aws_vpc.default.id}",
                "name": "ec2-demo-ec2",
                "description": "Lightning Server EC2 Demo single-instance access"
            }
        },
        "aws_vpc_security_group_ingress_rule": {
            "http_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "to_port": 80,
                "from_port": 80,
                "ip_protocol": "tcp"
            },
            "http": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "to_port": 80,
                "from_port": 80,
                "ip_protocol": "tcp"
            },
            "https": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "to_port": 443,
                "from_port": 443,
                "ip_protocol": "tcp"
            },
            "https_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "to_port": 443,
                "from_port": 443,
                "ip_protocol": "tcp"
            }
        },
        "aws_vpc_security_group_egress_rule": {
            "access_outside": {
                "cidr_ipv4": "0.0.0.0/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "ip_protocol": -1
            },
            "access_outside_v6": {
                "cidr_ipv6": "::/0",
                "security_group_id": "${aws_security_group.ec2.id}",
                "ip_protocol": -1
            }
        }
    }
}