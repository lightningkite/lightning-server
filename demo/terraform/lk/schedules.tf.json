{
    "resource": {
        "aws_cloudwatch_event_rule": {
            "scheduled_task_taskstasksscheduledhealthcheck": {
                "name": "LightningServerDemo_taskstasksscheduledhealthcheck",
                "schedule_expression": "rate(1 minute)"
            },
            "scheduled_task_uploadcleanupUploads": {
                "name": "LightningServerDemo_uploadcleanupUploads",
                "schedule_expression": "rate(1440 minutes)"
            },
            "scheduled_task_taskstasksscheduledcleanup": {
                "name": "LightningServerDemo_taskstasksscheduledcleanup",
                "schedule_expression": "rate(5 minutes)"
            }
        },
        "aws_cloudwatch_event_target": {
            "scheduled_task_taskstasksscheduledhealthcheck": {
                "input": "{\"scheduled\": \"/tasks/tasks/scheduled-health-check\"}",
                "rule": "${aws_cloudwatch_event_rule.scheduled_task_taskstasksscheduledhealthcheck.name}",
                "target_id": "lambda",
                "arn": "${aws_lambda_alias.main.arn}"
            },
            "scheduled_task_uploadcleanupUploads": {
                "input": "{\"scheduled\": \"/upload/cleanupUploads\"}",
                "rule": "${aws_cloudwatch_event_rule.scheduled_task_uploadcleanupUploads.name}",
                "target_id": "lambda",
                "arn": "${aws_lambda_alias.main.arn}"
            },
            "scheduled_task_taskstasksscheduledcleanup": {
                "input": "{\"scheduled\": \"/tasks/tasks/scheduled-cleanup\"}",
                "rule": "${aws_cloudwatch_event_rule.scheduled_task_taskstasksscheduledcleanup.name}",
                "target_id": "lambda",
                "arn": "${aws_lambda_alias.main.arn}"
            }
        }
    }
}