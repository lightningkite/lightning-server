{
    "provider": {
        "aws": [
            {
                "region": "us-west-2"
            },
            {
                "region": "us-east-1",
                "alias": "acm"
            }
        ]
    },
    "terraform": {
        "required_providers": {
            "mongodbatlas": {
                "source": "mongodb/mongodbatlas",
                "version": "~> 2.7.0"
            },
            "aws": {
                "source": "hashicorp/aws",
                "version": "~> 6.34.0"
            }
        },
        "required_version": "~> 1.0",
        "backend": {
            "s3": {
                "bucket": "lightningkite-terraform",
                "encrypt": false,
                "region": "us-west-2",
                "key": "lightningserverdemo"
            }
        }
    }
}