{
    "data": {
        "aws_iam_policy_document": {
            "email": {
                "statement": {
                    "resources": [
                        "*"
                    ],
                    "actions": [
                        "ses:SendRawEmail"
                    ]
                }
            }
        }
    },
    "resource": {
        "aws_ses_domain_mail_from": {
            "email": {
                "domain": "example.demo.ivieleague.com",
                "mail_from_domain": "mail.example.demo.ivieleague.com"
            }
        },
        "aws_iam_access_key": {
            "email": {
                "user": "${aws_iam_user.email.name}"
            }
        },
        "aws_iam_policy": {
            "email": {
                "name": "demo-example-email-policy",
                "description": "Allows sending of e-mails via Simple Email Service",
                "policy": "${data.aws_iam_policy_document.email.json}"
            }
        },
        "aws_iam_user_policy_attachment": {
            "email": {
                "policy_arn": "${aws_iam_policy.email.arn}",
                "user": "${aws_iam_user.email.name}"
            }
        },
        "aws_route53_record": {
            "email_mx": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "10 feedback-smtp.us-west-2.amazonses.com"
                ],
                "name": "${aws_ses_domain_mail_from.email.mail_from_domain}",
                "type": "MX",
                "ttl": "600"
            },
            "email_route_53_dmarc_txt": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "v=DMARC1;p=quarantine;pct=75;rua=mailto:josephivie@gmail.com"
                ],
                "name": "_dmarc.example.demo.ivieleague.com",
                "type": "TXT",
                "ttl": "300"
            },
            "email_spf_domain": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "v=spf1 include:amazonses.com -all"
                ],
                "name": "${aws_ses_domain_identity.email.domain}",
                "type": "TXT",
                "ttl": "300"
            },
            "email_spf_mail_from": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "v=spf1 include:amazonses.com -all"
                ],
                "name": "${aws_ses_domain_mail_from.email.mail_from_domain}",
                "type": "TXT",
                "ttl": "300"
            },
            "email_dkim_records": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "${aws_ses_domain_dkim.email_dkim.dkim_tokens[count.index]}"
                ],
                "count": 3,
                "name": "${element(aws_ses_domain_dkim.email_dkim.dkim_tokens, count.index)}._domainkey.example.demo.ivieleague.com",
                "type": "CNAME",
                "ttl": "600"
            },
            "email": {
                "zone_id": "${data.aws_route53_zone.main.zone_id}",
                "records": [
                    "${aws_ses_domain_identity.email.verification_token}"
                ],
                "name": "_amazonses.example.demo.ivieleague.com",
                "type": "TXT",
                "ttl": "600"
            }
        },
        "aws_iam_user": {
            "email": {
                "name": "demo-example-email-user"
            }
        },
        "aws_ses_domain_identity": {
            "email": {
                "domain": "example.demo.ivieleague.com"
            }
        },
        "aws_ses_domain_dkim": {
            "email_dkim": {
                "domain": "${aws_ses_domain_identity.email.domain}"
            }
        }
    }
}